# ── server ────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# ── AI (server only — never exposed to the browser) ───────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change; check the official Gemini API docs before changing this.
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_CHEAP=gemini-flash-latest

# Hard ceiling on Gemini calls per day, across all agents.
DAILY_REQUEST_LIMIT=200
PER_JOB_REQUEST_LIMIT=20

# Seed for the simulation's RNG. Set for reproducible bug reports.
# SIM_SEED=42

# ── persistence ───────────────────────────────────────────────────────────
# SQLite file for tasks, lessons, looks, positions and chats.
# DATABASE_PATH=data/hive.sqlite
# Folder Obsidian should open as the Second Brain vault.
# OBSIDIAN_VAULT_PATH=data/vault

# ── TikTok pipeline ────────────────────────────────────────────────────────
# DATA_DIR=data
# TIMEZONE=America/New_York
# POSTING_WINDOWS=12:00,19:00,21:00
# EDITOR_ENABLED=false
# MAX_UPLOAD_MB=200
# FFMPEG_PATH=
# FFPROBE_PATH=

# ── client (Vite) ─────────────────────────────────────────────────────────
# Leave unset to use the Vite dev proxy to PORT above.
# VITE_API_URL=http://localhost:8787
